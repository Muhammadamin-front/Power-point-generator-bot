{
  "name": "student-xizmat-bot",
  "version": "1.0.0",
  "description": "Talabalar uchun referat, taqdimot va boshqa ishlarni tayyorlovchi Telegram bot + Mini App",
  "main": "src/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "sample": "node --disable-warning=ExperimentalWarning scripts/sample.js",
    "bake": "node scripts/bake/bake.js && node scripts/bake/previews.js",
    "local": "bash scripts/start-local.sh",
    "test": "node --experimental-test-module-mocks --disable-warning=ExperimentalWarning tests/web.mjs && node --disable-warning=ExperimentalWarning tests/bot.mjs",
    "web:build": "cd web && npm install && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.29.1",
    "docx": "^9.10.0",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}
