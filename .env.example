# ---------- Telegram ----------
# @BotFather'dan olingan bot tokeni
BOT_TOKEN=
# Mini App ochiladigan ommaviy HTTPS manzil (shu server shu manzilda ishlashi kerak)
WEBAPP_URL=https://bot.example.uz
PORT=3000
# Adminlarning Telegram ID'lari, vergul bilan (ID'ingizni @userinfobot orqali bilib olasiz)
ADMIN_IDS=
# Foydalanuvchilar yozishi mumkin bo'lgan yordam akkaunti (@ belgisisiz)
SUPPORT_USERNAME=

# ---------- AI ----------
# gemini (bepul) yoki claude
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# Asosiy model band (503) yoki limitga yetsa (429) ishlatiladigan zaxira
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — yuqoriroq = sifatliroq, lekin qimmatroq va sekinroq
AI_EFFORT=medium
# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# ---------- Ixtiyoriy: slaydlar uchun rasmlar (https://www.pexels.com/api/) ----------
PEXELS_API_KEY=

# ---------- To'lovlar ----------
# Click / Payme — avtomatik to'lov (Uzcard, Humo, Visa). Token: @BotFather → Bot Settings → Payments
PAYMENT_PROVIDER_TOKEN=
PAYMENT_PROVIDER_NAME=Click / Payme
# Ixtiyoriy: provayder fiskal chek uchun provider_data talab qilsa — JSON qatori (provayder hujjatiga qarang)
PAYMENT_PROVIDER_DATA=
# Karta orqali qo'lda to'lov (bo'sh qoldirilsa bu usul o'chadi)
CARD_NUMBER=
CARD_OWNER=
MIN_CARD_TOPUP=5000
# 1 Telegram Star necha so'mga teng hisoblanadi
STAR_PRICE_SOM=200
# Yangi foydalanuvchiga bonus va do'st taklif qilganlik uchun bonus (so'm)
START_BONUS=5000
REFERRAL_BONUS=2000

# Ixtiyoriy majburiy obuna: buyurtmadan oldin shu kanalga a'zo bo'lish talab qilinadi
# (bot kanalda admin bo'lishi kerak). Masalan: @talaba_kanal
REQUIRED_CHANNEL=

# ---------- Navbat va fayllar ----------
MAX_ACTIVE_ORDERS=2
QUEUE_CONCURRENCY=3
FILE_TTL_DAYS=30
# DATA_DIR=data

# Faqat lokal sinov uchun: Mini App'ni brauzerda Telegramsiz ochish.
# Productionda (NODE_ENV=production) avtomatik o'chadi.
# DEV_USER_ID=
